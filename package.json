{
  "name": "profile-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "test": "node --test && pnpm test:browser",
    "test:browser": "playwright test && playwright test --config=playwright-empty-category.config.mjs && playwright test --config=playwright-long-detail.config.mjs",
    "test:unit": "node --test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "4.11.0",
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.8",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "^5.17.1",
    "typescript": "^5.9.3"
  }
}
