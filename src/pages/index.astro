---
import {
  formattedLocation,
  professionalProfiles,
  resume,
  timeline,
} from "../lib/resume";

const readPath = `${import.meta.env.BASE_URL}read/`;
const location = formattedLocation;
const profiles = professionalProfiles;
const title = `${resume.basics.name} | ${resume.basics.label}`;
const description = `Trayectoria profesional de ${resume.basics.name}, ${resume.basics.label.toLowerCase()}.`;
const canonicalUrl = Astro.url.href;
const personId = `${canonicalUrl}#person`;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": personId,
      "@type": "Person",
      name: resume.basics.name,
      jobTitle: resume.basics.label,
      description: resume.basics.summary,
      ...(resume.basics.url && { url: resume.basics.url }),
      ...(profiles.length > 0 && { sameAs: profiles.map((profile) => profile.url) }),
    },
    {
      "@type": "ProfilePage",
      name: title,
      description,
      url: canonicalUrl,
      mainEntity: {
        "@id": personId,
      },
    },
  ],
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_ES" />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body>
    <main>
      <header>
        <h1>{resume.basics.name}</h1>
        <p>{resume.basics.label}</p>
        <nav aria-label="Acciones principales">
          <a href={readPath}>Leer CV web</a>
          <a href={`mailto:${resume.basics.email}`}>Contactar</a>
        </nav>
        <p>{resume.basics.summary}</p>
        {location && <p>{location}</p>}
        {(resume.basics.url || profiles.length > 0) && (
          <nav aria-label="Enlaces profesionales">
            {resume.basics.url && (
              <a href={resume.basics.url}>Sitio web</a>
            )}
            {profiles.map((profile) => (
              <a href={profile.url}>{profile.network}</a>
            ))}
          </nav>
        )}
      </header>
      {timeline.length > 0 && (
        <section aria-labelledby="timeline-heading">
          <h2 id="timeline-heading">Trayectoria</h2>
          <ol>
            {timeline.map((milestone) => (
              <li>
                <article>
                  <p>{milestone.categoryLabel}</p>
                  {milestone.title && <h3>{milestone.title}</h3>}
                  {milestone.entity && <p>{milestone.entity}</p>}
                  <p>
                    <time datetime={milestone.startDate}>
                      {milestone.startDateLabel}
                    </time>
                    {milestone.endDate ? (
                      <>
                        {" - "}
                        <time datetime={milestone.endDate}>
                          {milestone.endDateLabel}
                        </time>
                      </>
                    ) : (
                      " - Actualidad"
                    )}
                  </p>
                  {milestone.location && <p>{milestone.location}</p>}
                  {milestone.description && <p>{milestone.description}</p>}
                  {milestone.summary && <p>{milestone.summary}</p>}
                  {milestone.roles.length > 0 && (
                    <>
                      <h4>Roles</h4>
                      <ul>
                        {milestone.roles.map((role) => (
                          <li>{role}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  {milestone.highlights.length > 0 && (
                    <>
                      <h4>Hitos destacados</h4>
                      <ul>
                        {milestone.highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  {milestone.skills.length > 0 && (
                    <>
                      <h4>Habilidades asociadas</h4>
                      <ul>
                        {milestone.skills.map((skill) => (
                          <li>{skill}</li>
                        ))}
                      </ul>
                    </>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </section>
      )}
    </main>
  </body>
</html>
