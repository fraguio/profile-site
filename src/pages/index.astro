---
import {
  formattedLocation,
  professionalProfiles,
  resume,
  timeline,
} from "../lib/resume";
import type { TimelineCategory } from "../lib/resume";
import PageMetadata from "../components/PageMetadata.astro";
import "../styles/interactive-experience.css";

const readPath = `${import.meta.env.BASE_URL}read/`;
const location = formattedLocation;
const profiles = professionalProfiles;
const title = `${resume.basics.name} | ${resume.basics.label}`;
const description = `Trayectoria profesional de ${resume.basics.name}, ${resume.basics.label.toLowerCase()}.`;
const canonicalUrl = Astro.url.href;
const personId = `${canonicalUrl}#person`;
const timelineFilterOptions = [
  { value: "all", label: "Toda la trayectoria" },
  { value: "work", label: "Experiencia profesional" },
  { value: "projects", label: "Proyectos" },
  { value: "education", label: "Formación" },
] satisfies Array<{ label: string; value: "all" | TimelineCategory }>;
const availableTimelineFilters = timelineFilterOptions.filter(
  (filter) =>
    filter.value === "all" ||
    timeline.some((milestone) => milestone.category === filter.value),
);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": personId,
      "@type": "Person",
      name: resume.basics.name,
      jobTitle: resume.basics.label,
      description: resume.basics.summary,
      ...(resume.basics.url && { url: resume.basics.url }),
      ...(profiles.length > 0 && { sameAs: profiles.map((profile) => profile.url) }),
    },
    {
      "@type": "ProfilePage",
      name: title,
      description,
      url: canonicalUrl,
      mainEntity: {
        "@id": personId,
      },
    },
  ],
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <PageMetadata {canonicalUrl} {description} {structuredData} {title} />
  </head>
  <body>
    <main class="interactive-experience">
      <header class="profile-hero">
        <p class="profile-hero__eyebrow">Perfil profesional</p>
        <h1>{resume.basics.name}</h1>
        <p class="profile-hero__role">{resume.basics.label}</p>
        <nav class="profile-hero__actions" aria-label="Acciones principales">
          <a href={readPath}>Leer CV web</a>
          <a href={`mailto:${resume.basics.email}`}>Contactar</a>
        </nav>
        <p class="profile-hero__summary">{resume.basics.summary}</p>
        {location && <p class="profile-hero__location">{location}</p>}
        {timeline.length > 0 && (
          <a class="profile-hero__explore" href="#timeline-heading">
            Explorar trayectoria
          </a>
        )}
        {(resume.basics.url || profiles.length > 0) && (
          <nav class="profile-hero__profiles" aria-label="Enlaces profesionales">
            {resume.basics.url && (
              <a href={resume.basics.url}>Sitio web</a>
            )}
            {profiles.map((profile) => (
              <a href={profile.url}>{profile.network}</a>
            ))}
          </nav>
        )}
      </header>
      {timeline.length > 0 && (
        <section class="timeline" aria-labelledby="timeline-heading">
          <h2 id="timeline-heading">Trayectoria</h2>
          <fieldset class="timeline__filters" data-contract="timeline-filters" hidden>
            <legend>Filtrar trayectoria</legend>
            <div class="timeline__filter-options">
              {availableTimelineFilters.map((filter) => (
                <label class="timeline__filter-option">
                  <input
                    aria-controls="timeline-rail"
                    checked={filter.value === "all"}
                    data-timeline-filter-label={filter.label}
                    name="timeline-filter"
                    type="radio"
                    value={filter.value}
                  />
                  {filter.label}
                </label>
              ))}
            </div>
          </fieldset>
          <p
            aria-atomic="true"
            class="visually-hidden"
            data-contract="timeline-filter-status"
            role="status"
          ></p>
          <ol
            aria-label="Hitos de la trayectoria"
            class="timeline__list timeline__rail"
            data-contract="timeline-rail"
            id="timeline-rail"
          >
            {timeline.map((milestone) => (
              <li class="timeline__item" data-timeline-category={milestone.category}>
                <article class="milestone">
                  <p class="milestone__category">{milestone.categoryLabel}</p>
                  {milestone.title && <h3>{milestone.title}</h3>}
                  {milestone.entity && <p class="milestone__entity">{milestone.entity}</p>}
                  <p class="milestone__period">
                    <time datetime={milestone.startDate}>
                      {milestone.startDateLabel}
                    </time>
                    {milestone.endDate ? (
                      <>
                        {" - "}
                        <time datetime={milestone.endDate}>
                          {milestone.endDateLabel}
                        </time>
                      </>
                    ) : (
                      " - Actualidad"
                    )}
                  </p>
                  {milestone.location && <p class="milestone__location">{milestone.location}</p>}
                  {milestone.description && <p class="milestone__description">{milestone.description}</p>}
                  {milestone.summary && <p class="milestone__summary">{milestone.summary}</p>}
                  {milestone.roles.length > 0 && (
                    <>
                      <h4>Roles</h4>
                      <ul class="milestone__roles">
                        {milestone.roles.map((role) => (
                          <li>{role}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  {milestone.highlights.length > 0 && (
                    <>
                      <h4>Hitos destacados</h4>
                      <ul class="milestone__highlights">
                        {milestone.highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  {milestone.skills.length > 0 && (
                    <>
                      <h4>Habilidades asociadas</h4>
                      <ul class="milestone__skills">
                        {milestone.skills.map((skill) => (
                          <li>{skill}</li>
                        ))}
                      </ul>
                    </>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </section>
      )}
    </main>
    <script>
      const filters = document.querySelector<HTMLFieldSetElement>(
        '[data-contract="timeline-filters"]',
      );
      const status = document.querySelector<HTMLElement>(
        '[data-contract="timeline-filter-status"]',
      );
      const rail = document.querySelector<HTMLOListElement>(
        '[data-contract="timeline-rail"]',
      );
      const milestones = [
        ...document.querySelectorAll<HTMLElement>("[data-timeline-category]"),
      ];

      if (filters && status && rail && milestones.length > 0) {
        document.documentElement.classList.add("timeline-enhanced");
        filters.hidden = false;
        rail.tabIndex = 0;

        filters.addEventListener("change", (event) => {
          const selectedFilter = event.target;

          if (
            !(selectedFilter instanceof HTMLInputElement) ||
            selectedFilter.name !== "timeline-filter"
          ) {
            return;
          }

          const visibleMilestones = milestones.filter((milestone) => {
            const matchesFilter =
              selectedFilter.value === "all" ||
              milestone.dataset.timelineCategory === selectedFilter.value;

            milestone.hidden = !matchesFilter;

            return matchesFilter;
          });
          const milestoneLabel =
            visibleMilestones.length === 1 ? "hito" : "hitos";
          const verb = visibleMilestones.length === 1 ? "muestra" : "muestran";
          const filterLabel = selectedFilter.dataset.timelineFilterLabel?.toLowerCase();

          status.textContent = `Se ${verb} ${visibleMilestones.length} ${milestoneLabel} de ${filterLabel}.`;
          rail.scrollTo({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "auto"
              : "smooth",
            top: 0,
          });
        });
      }
    </script>
  </body>
</html>
