---
import PageMetadata from "../components/PageMetadata.astro";
import SemanticFallback from "../prototypes/interactive-experience/SemanticFallback.astro";
import VariantA from "../prototypes/interactive-experience/variants/VariantA.astro";
import VariantB from "../prototypes/interactive-experience/variants/VariantB.astro";
import VariantC from "../prototypes/interactive-experience/variants/VariantC.astro";
import { prototypeResume } from "../prototypes/interactive-experience/data";
import "../styles/interactive-prototype.css";

const readPath = `${import.meta.env.BASE_URL}read/`;
const pdfPath = `${import.meta.env.BASE_URL}cv/eduardo-nogueira-fraguio-cv.pdf`;
const title = `${prototypeResume.basics.name} | ${prototypeResume.basics.label}`;
const description = `Trayectoria profesional de ${prototypeResume.basics.name}, ${prototypeResume.basics.label.toLowerCase()}.`;
const canonicalUrl = Astro.url.href;
const personId = `${canonicalUrl}#person`;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": personId,
      "@type": "Person",
      name: prototypeResume.basics.name,
      jobTitle: prototypeResume.basics.label,
      description: prototypeResume.basics.summary,
      ...(prototypeResume.basics.url && { url: prototypeResume.basics.url }),
    },
    {
      "@type": "ProfilePage",
      name: title,
      description,
      url: canonicalUrl,
      mainEntity: { "@id": personId },
    },
  ],
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <PageMetadata {canonicalUrl} {description} {structuredData} {title} />
  </head>
  <body>
    <SemanticFallback {pdfPath} {readPath} />
    <main aria-live="polite" hidden id="prototype-variant-app"></main>
    <template id="prototype-variant-A"><VariantA /></template>
    <template id="prototype-variant-B"><VariantB /></template>
    <template id="prototype-variant-C"><VariantC /></template>
    <script>
      const variants = [
        { id: "A", name: "Capítulos editoriales" },
        { id: "B", name: "Sistema en evolución" },
        { id: "C", name: "Dossier de modernización" },
      ] as const;
      const app = document.querySelector<HTMLElement>("#prototype-variant-app");
      const fallback = document.querySelector<HTMLElement>("#prototype-fallback");
      const selector = document.createElement("aside");
      const previous = document.createElement("button");
      const next = document.createElement("button");
      const status = document.createElement("p");

      let activeIndex = 0;

      selector.className = "prototype-selector";
      selector.setAttribute("aria-label", "Selector del prototipo");
      previous.type = "button";
      next.type = "button";
      status.className = "prototype-selector__status";
      status.setAttribute("aria-live", "polite");
      selector.append(previous, status, next);
      document.body.append(selector);

      function requestedIndex() {
        const requested = new URL(window.location.href).searchParams
          .get("variant")
          ?.toUpperCase();
        const index = variants.findIndex((variant) => variant.id === requested);

        return index === -1 ? 0 : index;
      }

      function render(index: number, replace = false) {
        if (!app || !fallback) {
          return;
        }

        activeIndex = index;
        const active = variants[activeIndex];
        const template = document.querySelector<HTMLTemplateElement>(
          `#prototype-variant-${active.id}`,
        );
        const url = new URL(window.location.href);

        url.searchParams.set("variant", active.id);
        history[replace ? "replaceState" : "pushState"]({}, "", url);
        app.replaceChildren(template?.content.cloneNode(true) ?? document.createTextNode(""));
        fallback.hidden = true;
        app.hidden = false;
        previous.textContent = `Anterior: ${variants[(activeIndex + variants.length - 1) % variants.length].id}`;
        next.textContent = `Siguiente: ${variants[(activeIndex + 1) % variants.length].id}`;
        status.textContent = `Variante ${active.id}: ${active.name}`;
      }

      previous.addEventListener("click", () => {
        render((activeIndex + variants.length - 1) % variants.length);
      });
      next.addEventListener("click", () => {
        render((activeIndex + 1) % variants.length);
      });
      window.addEventListener("popstate", () => render(requestedIndex(), true));
      document.addEventListener("keydown", (event) => {
        const target = event.target;

        if (
          target instanceof HTMLElement &&
          target.matches("input, textarea, select, [contenteditable='true']")
        ) {
          return;
        }

        if (event.key === "ArrowLeft") {
          event.preventDefault();
          render((activeIndex + variants.length - 1) % variants.length);
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          render((activeIndex + 1) % variants.length);
        }
      });

      render(requestedIndex(), true);
    </script>
  </body>
</html>
