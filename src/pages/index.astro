---
import {
  formattedLocation,
  professionalProfiles,
  resume,
  timeline,
} from "../lib/resume";
import type { TimelineCategory } from "../lib/resume";
import PageMetadata from "../components/PageMetadata.astro";
import ProfileIcon from "../components/ProfileIcon.astro";
import "../styles/interactive-experience.css";

const readPath = `${import.meta.env.BASE_URL}read/`;
const pdfPath = `${import.meta.env.BASE_URL}cv/eduardo-nogueira-fraguio-cv.pdf`;
const location = formattedLocation;
const profiles = professionalProfiles;
const monogram = resume.basics.name.trim().split(/\s+/u).map((part) => [...part][0]).join("");
const title = `${resume.basics.name} | ${resume.basics.label}`;
const description = `Trayectoria profesional de ${resume.basics.name}, ${resume.basics.label.toLowerCase()}.`;
const canonicalUrl = Astro.url.href;
const personId = `${canonicalUrl}#person`;
const timelineFilterOptions = [
  { value: "all", label: "Todo" },
  { value: "work", label: "Experiencia profesional" },
  { value: "education", label: "Formación" },
  { value: "projects", label: "Proyectos" },
] satisfies Array<{ label: string; value: "all" | TimelineCategory }>;
const availableTimelineFilters = timelineFilterOptions.filter(
  (filter) =>
    filter.value === "all" ||
    timeline.some((milestone) => milestone.category === filter.value),
);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": personId,
      "@type": "Person",
      name: resume.basics.name,
      jobTitle: resume.basics.label,
      description: resume.basics.summary,
      ...(resume.basics.url && { url: resume.basics.url }),
      ...(profiles.length > 0 && { sameAs: profiles.map((profile) => profile.url) }),
    },
    {
      "@type": "ProfilePage",
      name: title,
      description,
      url: canonicalUrl,
      mainEntity: {
        "@id": personId,
      },
    },
  ],
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <PageMetadata {canonicalUrl} {description} {structuredData} {title} />
  </head>
  <body>
    <div class="profile-frame">
    <header class="profile-navigation">
      <div class="profile-navigation__brand">
        <span class="profile-navigation__monogram" aria-hidden="true">{monogram}</span>
        <span class="profile-navigation__separator" aria-hidden="true"></span>
        <span class="profile-navigation__name">{resume.basics.name}</span>
      </div>
      <nav aria-label="Navegación del perfil">
        <a href={readPath}>CV web</a>
        <a href={pdfPath} download>CV PDF</a>
        <a href={`mailto:${resume.basics.email}`}>Contacto</a>
      </nav>
    </header>
    <main class="interactive-experience">
      <header class="profile-hero">
        <h1>{resume.basics.name}</h1>
        <p class="profile-hero__role">{resume.basics.label}</p>
        <p class="profile-hero__summary">{resume.basics.summary}</p>
        <nav class="profile-hero__actions" aria-label="Acciones principales">
          <a href={readPath}><ProfileIcon name="read" />Leer CV web</a>
          <a href={pdfPath} download><ProfileIcon name="download" />Descargar CV PDF</a>
          <a href={`mailto:${resume.basics.email}`}><ProfileIcon name="mail" />Contactar</a>
        </nav>
        {location && <p class="profile-hero__location">{location}</p>}
        {timeline.length > 0 && (
          <a class="profile-hero__explore" href="#timeline-heading">
            Explorar trayectoria
          </a>
        )}
        {(resume.basics.url || profiles.length > 0) && (
          <nav class="profile-hero__profiles" aria-label="Enlaces profesionales">
            {resume.basics.url && (
               <a href={resume.basics.url}><ProfileIcon name="web" />Sitio web</a>
            )}
            {profiles.map((profile) => (
               <a href={profile.url}><ProfileIcon name={profile.network.toLowerCase()} />{profile.network}</a>
            ))}
          </nav>
        )}
        <div class="profile-hero__accessibility">
          <p><ProfileIcon name="keyboard" />Navegación por teclado</p>
          <p><ProfileIcon name="reduced-motion" />Movimiento reducido compatible</p>
        </div>
      </header>
      {timeline.length > 0 && (
        <section class="timeline" aria-labelledby="timeline-heading">
          <h2 id="timeline-heading">Trayectoria</h2>
          <fieldset class="timeline__filters" data-contract="timeline-filters" hidden>
            <legend>Filtrar trayectoria</legend>
            <div class="timeline__filter-options">
              {availableTimelineFilters.map((filter) => (
                <button class="timeline__filter-option"
                    aria-label={filter.label}
                    aria-controls="timeline-rail"
                    aria-pressed={filter.value === "all" ? "true" : "false"}
                    data-timeline-filter-label={filter.value === "all" ? "Toda la trayectoria" : filter.label}
                    name="timeline-filter"
                    type="button"
                    value={filter.value}
                  >
                  {filter.value === "work" ? "Experiencia" : filter.label}
                </button>
              ))}
            </div>
          </fieldset>
          <p
            aria-atomic="true"
            class="visually-hidden"
            data-contract="timeline-filter-status"
            role="status"
          ></p>
          <div class="timeline__experience">
            <ol
              aria-label="Hitos de la trayectoria"
              class="timeline__list timeline__rail"
              data-contract="timeline-rail"
              id="timeline-rail"
            >
              {timeline.map((milestone) => (
                <li class="timeline__item" data-timeline-category={milestone.category}>
                  <article class="milestone">
                    <div class="milestone__summary" data-contract="milestone-summary">
                      <span class="milestone__node" aria-hidden="true"></span>
                      <span class="milestone__period--compact" aria-hidden="true">
                        {milestone.startDate.slice(0, 4)}{milestone.endDate
                          ? milestone.startDate.slice(0, 4) !== milestone.endDate.slice(0, 4) && (
                            <span class="milestone__period-end">{` – ${milestone.endDate.slice(0, 4)}`}</span>
                          )
                          : <span class="milestone__period-end"> – Actualidad</span>}
                      </span>
                      <div class="milestone__surface">
                        <div class="milestone__text">
                          <p class="milestone__category">{milestone.category === "work" ? "Experiencia" : milestone.category === "projects" ? "Proyecto" : milestone.categoryLabel}</p>
                          {milestone.title && <h3>{milestone.title}</h3>}
                          {milestone.entity && <p class="milestone__entity">{milestone.entity}</p>}
                        </div>
                        <span class="milestone__chevron" aria-hidden="true"><ProfileIcon name="chevron-right" /></span>
                      </div>
                      <p class="milestone__period">
                        <ProfileIcon name="calendar" />
                        <span>
                        <time datetime={milestone.startDate}>
                          {milestone.startDateLabel}
                        </time>
                        {milestone.endDate ? (
                          <>
                            {" - "}
                            <time datetime={milestone.endDate}>
                              {milestone.endDateLabel}
                            </time>
                          </>
                        ) : (
                          " - Actualidad"
                        )}
                        </span>
                      </p>
                      {milestone.location && <p class="milestone__location"><ProfileIcon name="location" /><span>{milestone.location}</span></p>}
                      {(milestone.roles.length > 0 || milestone.position) && (
                        <p class="milestone__role"><ProfileIcon name="role" /><span>
                          {milestone.roles.length > 0
                            ? `${milestone.roles.length === 1 ? "Rol" : "Roles"}: ${milestone.roles.join(", ")}`
                            : `Rol: ${milestone.position}`}
                        </span></p>
                      )}
                      {milestone.url && <a class="milestone__project-link" href={milestone.url}>Ver proyecto<ProfileIcon name="external-link" /></a>}
                    </div>
                    <div class="milestone__detail" data-contract="milestone-detail">
                      {(milestone.description || milestone.summary) && (
                        <>
                          <h4>Descripción</h4>
                          {milestone.description && <p class="milestone__description">{milestone.description}</p>}
                          {milestone.summary && <p class="milestone__summary">{milestone.summary}</p>}
                        </>
                      )}
                      {milestone.highlights.length > 0 && (
                        <>
                          <h4>{milestone.category === "education" ? "Contenidos" : "Contribuciones"}</h4>
                          <ul class="milestone__highlights">
                            {milestone.highlights.map((highlight) => (
                              <li>{highlight}</li>
                            ))}
                          </ul>
                        </>
                      )}
                      {milestone.skills.length > 0 && (
                        <>
                          <h4>Habilidades asociadas</h4>
                          <ul class="milestone__skills">
                            {milestone.skills.map((skill) => (
                              <li>{skill}</li>
                            ))}
                          </ul>
                        </>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )}
    </main>
    </div>
    <script>
      import "../lib/timeline";
    </script>
  </body>
</html>
