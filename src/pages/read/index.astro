---
import {
  formattedLocation,
  professionalProfiles,
  resume,
  timeline,
  type TimelineCategory,
} from "../../lib/resume";

const interactiveExperiencePath = import.meta.env.BASE_URL;
const location = formattedLocation;
const profiles = professionalProfiles;
const title = `CV web | ${resume.basics.name}`;
const description = `CV web de ${resume.basics.name}, ${resume.basics.label.toLowerCase()}.`;
const canonicalUrl = Astro.url.href;
const sectionDefinitions: Array<{ category: TimelineCategory; heading: string }> = [
  {
    category: "work",
    heading: "Experiencia profesional",
  },
  {
    category: "projects",
    heading: "Proyectos",
  },
  {
    category: "education",
    heading: "Formación",
  },
];
const sections = sectionDefinitions.map((section) => ({
  ...section,
  milestones: timeline.filter((milestone) => milestone.category === section.category),
})).filter((section) => section.milestones.length > 0);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_ES" />
    <style is:global>
      body {
        color: #171717;
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.5;
        margin: 0;
      }

      main {
        margin: 0 auto;
        max-width: 72rem;
        padding: 2rem;
      }

      header > * {
        margin-block: 0.5rem;
      }

      section {
        margin-block: 2.5rem;
      }

      ol,
      ul {
        padding-inline-start: 1.5rem;
      }

      article {
        margin-block: 1.5rem;
      }

      [data-contract="read-print-action"] {
        display: none;
      }

      html[data-javascript="enabled"] [data-contract="read-print-action"] {
        display: inline-block;
      }

      @media print {
        @page {
          margin: 2cm;
          size: A4;
        }

        body {
          font-size: 10pt;
          line-height: 1.35;
        }

        main {
          max-width: none;
          padding: 0;
        }

        [data-contract="read-actions"] {
          display: none;
        }

        a {
          color: inherit;
          text-decoration: none;
        }

        article {
          break-inside: avoid-page;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>{resume.basics.name}</h1>
        <p>{resume.basics.label}</p>
        <address>
          <ul>
            <li><a href={`mailto:${resume.basics.email}`}>{resume.basics.email}</a></li>
            {location && <li>{location}</li>}
          </ul>
        </address>
        {(resume.basics.url || profiles.length > 0) && (
          <nav aria-label="Enlaces profesionales">
            <ul>
              {resume.basics.url && (
                <li><a href={resume.basics.url}>{resume.basics.url}</a></li>
              )}
              {profiles.map((profile) => (
                <li><a href={profile.url}>{profile.network}</a></li>
              ))}
            </ul>
          </nav>
        )}
        <nav aria-label="Acciones del documento" data-contract="read-actions">
          <button data-contract="read-print-action" type="button">Imprimir CV web</button>
          <a href={interactiveExperiencePath}>Volver a la experiencia interactiva</a>
        </nav>
      </header>

      <section aria-labelledby="summary-heading">
        <h2 id="summary-heading">Resumen profesional</h2>
        <p>{resume.basics.summary}</p>
      </section>

      {sections.map((section) => (
        <section aria-labelledby={`${section.category}-heading`}>
          <h2 id={`${section.category}-heading`}>{section.heading}</h2>
          <ol>
            {section.milestones.map((milestone) => (
              <li>
                <article>
                  <header>
                    {milestone.title && <h3>{milestone.title}</h3>}
                    {milestone.entity && <p>{milestone.entity}</p>}
                    <p>
                      <time datetime={milestone.startDate}>
                        {milestone.startDateLabel}
                      </time>
                      {milestone.endDate ? (
                        <>
                          {" - "}
                          <time datetime={milestone.endDate}>
                            {milestone.endDateLabel}
                          </time>
                        </>
                      ) : (
                        " - Actualidad"
                      )}
                    </p>
                    {milestone.location && <p>{milestone.location}</p>}
                  </header>
                  {milestone.description && <p>{milestone.description}</p>}
                  {milestone.summary && <p>{milestone.summary}</p>}
                  {[
                    { heading: "Roles", values: milestone.roles },
                    { heading: "Hitos destacados", values: milestone.highlights },
                    { heading: "Habilidades asociadas", values: milestone.skills },
                  ].filter((detail) => detail.values.length > 0).map((detail) => (
                    <>
                      <h4>{detail.heading}</h4>
                      <ul>
                        {detail.values.map((value) => (
                          <li>{value}</li>
                        ))}
                      </ul>
                    </>
                  ))}
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </main>
    <script is:inline>
      document.documentElement.dataset.javascript = "enabled";
      document
        .querySelector("[data-contract='read-print-action']")
        ?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>
