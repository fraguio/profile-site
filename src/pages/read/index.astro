---
import { resume } from "../../lib/resume";

const interactiveExperiencePath = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CV web | {resume.basics.name}</title>
  </head>
  <body>
    <main>
      <h1>{resume.basics.name}</h1>
      <p>{resume.basics.label}</p>
      <a href={`mailto:${resume.basics.email}`}>{resume.basics.email}</a>
      <h2>Resumen profesional</h2>
      <p>{resume.basics.summary}</p>
      <a href={interactiveExperiencePath}>Volver a la experiencia interactiva</a>
    </main>
  </body>
</html>
